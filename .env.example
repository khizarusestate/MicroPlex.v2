# Copy this to .env for local testing with `vercel dev` — never commit the real .env file.
# In production, set these in your Vercel project: Settings -> Environment Variables.

# The Gmail address that sends the notification (and receives it, since
# EMAIL_USER is both the sender and the recipient in api/contact.js).
EMAIL_USER=your-gmail-address@gmail.com

# A Gmail App Password — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account)
EMAIL_PASS=your-16-character-app-password
